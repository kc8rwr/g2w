<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<?php
	// Same colors and order as template.phtml's CSS variables, as HTML attributes for browsers without CSS.
	// Without a configured page color, match the domain's background tile
	[$pageBg, $text, $panelBg, $panelBorder, , $iconBorder] = Config::$aesthetics->htmlColors([
		domainArt()->backgroundColor(),
		'#000000',
		'#fffdfa',
		'#262018',
		'#eeeeee',
		'#cccccc',
	]);

	// Frame around inline gemtext images: panel colored inside, a 1 pixel icon border colored edge
	GemTextToHTML::$retroImageColors = [$panelBg, $iconBorder];

	// A 1 pixel border made by a border colored table padding a panel colored one, since bordercolor isn't portable
	// $fill stretches the panel to the height of the cell it is in, for the content panel to fill the window
	$openPanel = function(string $align = 'left', int $padding = 12, bool $fill = false) use ($panelBg, $panelBorder){
		$height = $fill ? ' height="100%"' : '';
		echo "<table width=\"100%\"{$height} border=\"0\" cellspacing=\"0\" cellpadding=\"1\" bgcolor=\"{$panelBorder}\"><tr><td valign=\"top\">\n";
		echo "<table width=\"100%\"{$height} border=\"0\" cellspacing=\"0\" cellpadding=\"{$padding}\" bgcolor=\"{$panelBg}\"><tr><td align=\"{$align}\" valign=\"top\">\n";
	};
	$closePanel = function(){
		echo "</td></tr></table>\n</td></tr></table>\n";
	};

	$bodyAttributes = "bgcolor=\"{$pageBg}\" text=\"{$text}\"";
	if ('' !== Config::$aesthetics->backgroundUrl()){
		$bodyAttributes .= ' background="' . Config::$aesthetics->backgroundUrl() . '"';
	}
?>
<html>
	<head>
		<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
		<base href="<?= htmlspecialchars(Config::$paths->baseHref) ?>">
		<title><?= $content->getTitle(Config::$aesthetics->siteTitle) ?></title>
		<?php if (!empty($content->getDescription())){ ?>
			<meta name="description" content="<?= $content->getDescription() ?>">
		<?php } ?>
		<?= Config::$aesthetics->getStylesheetLink() ?>
		<?php if ('' !== Config::$aesthetics->faviconUrl()){ ?>
			<link rel="shortcut icon" href="<?= Config::$aesthetics->faviconUrl() ?>">
		<?php } ?>
	</head>
	<body <?= $bodyAttributes ?> marginwidth="0" marginheight="0" leftmargin="0" topmargin="0">
		<!--
			Fills the window so short pages still reach the bottom. height="100%" is non-standard but old browsers honor it,
			newer ones need retro.css's html, body { height: 100% }. cellspacing gives the 8px margins and gaps between panels,
			body margins would push a 100% height table past the window. height="1" keeps the header and footer rows
			at their natural height so the content row takes the rest.
		-->
		<table width="100%" height="100%" border="0" cellspacing="8" cellpadding="0">
		<tr><td height="1" valign="top">
		<?php $openPanel('center'); ?>
			<?php if ('' !== Config::$aesthetics->logoUrl()){ ?>
				<!-- Logo on the left, title centered across the whole header by an empty cell of the same width on the right -->
				<table width="100%" border="0" cellspacing="0" cellpadding="0"><tr>
					<td width="64" align="left" valign="middle"><img src="<?= Config::$aesthetics->logoUrl() ?>" width="64" height="64" alt="" border="0"></td>
					<td align="center" valign="middle"><h1><?= $content->getTitle(Config::$aesthetics->siteTitle) ?></h1></td>
					<td width="64">&nbsp;</td>
				</tr></table>
			<?php } else { ?>
				<h1><?= $content->getTitle(Config::$aesthetics->siteTitle) ?></h1>
			<?php } ?>
		<?php $closePanel(); ?>
		</td></tr>
		<tr><td valign="top">
		<?php $openPanel('left', 24, true); ?>
			<?php $content->stream(); ?>
		<?php $closePanel(); ?>
		</td></tr>
		<?php if (!empty(Config::$aesthetics->footerText)) { ?>
			<tr><td height="1" valign="bottom">
			<?php $openPanel('right'); ?>
				<?= Config::$aesthetics->footerText ?>
			<?php $closePanel(); ?>
			</td></tr>
		<?php } ?>
		</table>
	</body>
</html>
